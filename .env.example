# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session / auth
AUTH_SECRET=

# Database (Neon PostgreSQL)
DATABASE_URL=

# Cache / rate limit (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Same value as R2_PUBLIC_BASE_URL — required for client components / next/image
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
# Optional; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=

# Email (Resend adapter)
EMAIL_FROM=
RESEND_API_KEY=

# Payment method availability (server-side; not secrets)
PAYMENT_ENABLE_COD=true
PAYMENT_ENABLE_ARCA=false
PAYMENT_ENABLE_IDRAM=false
# When true, card/iDram only for logged-in ADMIN (cash for everyone else).
PAYMENT_ONLINE_ADMIN_ONLY=true

# ARCA EPG (server-only; required when PAYMENT_ENABLE_ARCA=true)
# Administration GUI credentials must NEVER be stored here — API account only.
# Keep PAYMENT_ENABLE_ARCA=false until sandbox acceptance + merchant mode confirmation.
# Official bases: test https://ipaytest.arca.am:8445/payment/rest
#                 prod https://ipay.arca.am/payment/rest
# Return path: {ARCA_RETURN_BASE_URL}/api/v1/payments/arca/return
# ARCA_ENVIRONMENT=test
# ARCA_PAYMENT_MODE=one_stage
# ARCA_API_BASE_URL=
# ARCA_API_USERNAME=
# ARCA_API_PASSWORD=
# Legacy aliases also accepted: ARCA_USERNAME / ARCA_PASSWORD;
# ARCA_MODE=test|production maps to ARCA_ENVIRONMENT only.
# ARCA_RETURN_BASE_URL=
# ARCA_REQUEST_TIMEOUT_MS=15000
# ARCA_CURRENCY_CODE=051
# ARCA_LANGUAGE=en
# ARCA_FORM_URL_ALLOWED_HOSTS=

# iDram Merchant API (server-only; required when PAYMENT_ENABLE_IDRAM=true)
# Never put the secret in NEXT_PUBLIC_*. Keep PAYMENT_ENABLE_IDRAM=false until ready.
# Prefer legacy WooCommerce public paths during migration so merchant cabinet stays unchanged.
# IDRAM_REC_ACCOUNT=
# IDRAM_SECRET_KEY=
# IDRAM_PAYMENT_URL=https://banking.idram.am/Payment/GetPayment
# IDRAM_RESULT_URL=https://grill.am/wc-api/idram_result
# IDRAM_SUCCESS_URL=https://grill.am/wc-api/idram_complete
# IDRAM_FAIL_URL=https://grill.am/wc-api/idram_fail
# Modern aliases also supported by the app:
# IDRAM_RESULT_URL=https://grill.am/api/v1/payments/idram/result
# IDRAM_SUCCESS_URL=https://grill.am/api/v1/payments/idram/success
# IDRAM_FAIL_URL=https://grill.am/api/v1/payments/idram/fail

# Integration tests (never point at production)
# TEST_DATABASE_URL=
# PAYMENT_INTEGRATION_ALLOW_DEV_DB=true

# E2E (Playwright) — never production
# E2E_DATABASE_URL=
# E2E_BASE_URL=http://127.0.0.1:3100
# E2E_PORT=3100
# E2E_PROVIDER_MODE=mock
# E2E_EMAIL_MODE=mock
# E2E_ALLOW_DEV_DB=true
# E2E_REUSE_SERVER=true

# Outbox worker
# OUTBOX_BATCH_SIZE=20
# OUTBOX_POLL_MS=2000
# OPS_ALERT_EMAIL=

# Dev/test seed only (never commit real passwords)
