{
  "name": "white-shop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/db/seed/run.ts",
    "create:admin": "tsx scripts/create-admin-user.ts",
    "create:operator": "tsx scripts/create-operator-user.ts",
    "sync:static-assets": "node scripts/sync-static-assets-to-r2.mjs",
    "products:wc-import:dry": "tsx scripts/import-woocommerce-products/cli.ts --mode dry-run",
    "products:wc-import:apply": "tsx scripts/import-woocommerce-products/cli.ts --mode apply",
    "products:wc-import:verify": "tsx scripts/import-woocommerce-products/cli.ts --mode verify",
    "payments:arca:reconcile": "tsx --require ./scripts/preload-server-only.cjs scripts/reconcile-arca-payments.ts",
    "payments:reconcile:full": "tsx --require ./scripts/preload-server-only.cjs scripts/reconcile-arca-payments.ts --full",
    "payments:idram:audit-pending": "tsx --require ./scripts/preload-server-only.cjs scripts/audit-idram-pending.ts",
    "payments:reconcile:dry": "tsx --require ./scripts/preload-server-only.cjs scripts/payments-reconcile-dry.ts",
    "payments:readiness": "tsx scripts/payments-readiness.ts",
    "e2e:db:prepare": "tsx tests/e2e/prepare-db.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.25.0",
    "motion": "^13.1.1",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "uuid": "^14.0.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
